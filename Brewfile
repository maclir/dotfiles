# Snapshot of installed Homebrew packages.
# Refresh with: make dump-brew
# Apply on a fresh machine with: make brew  (or `brew bundle`)
#
# The spotify/sptaps tap needs GHE access; entries from it will fail
# on non-Spotify machines and can be commented out individually.

tap "asheshgoplani/tap"
tap "spotify/sptaps", "git@ghe.spotify.net:shared/homebrew-spotify.git"

# Bourne-Again SHell, a UNIX command interpreter
brew "bash"
# Clone of cat(1) with syntax highlighting and Git integration
brew "bat"
# User-friendly launcher for Bazel
brew "bazelisk"
# Color-highlighted diff(1) output
